# Bu dosyayı .env.docker olarak kopyalayın ve TÜM değerleri değiştirin!
# cp .env.docker.example .env.docker

DATABASE_URL="postgresql://kaportapp_user:YOUR_STRONG_DB_PASSWORD@vurthex-db:5432/kaportapp_db"
ADMIN_EMAIL="admin@yourdomain.com"
# Bcrypt hash kullanın: node -e "require('bcryptjs').hash('SIFRENIZ', 12).then(console.log)"
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"
ADMIN_NAME="System Admin"
# Oluşturun: openssl rand -hex 32
JWT_SECRET="YOUR_RANDOM_64_CHAR_SECRET_RUN_OPENSSL_RAND_HEX_32"
UPLOAD_DIR="/app/uploads"
UPLOAD_URL_PREFIX="/api/uploads"
LOG_DIR="/app/logs"
LOG_LEVEL="info"
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@redis:6379"
TRUST_PROXY="true"
