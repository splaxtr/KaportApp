generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  name               String
  role               String     @default("null")
  shopId             String?
  hashedRefreshToken String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLogin          DateTime?
  activities         Activity[]
  ownedShops         Shop[]     @relation("ShopOwner")
  shop               Shop?      @relation("ShopUsers", fields: [shopId], references: [id])
}

model Shop {
  id             String               @id @default(uuid())
  name           String
  ownerId        String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  customVehicles CustomVehicleEntry[]
  owner          User                 @relation("ShopOwner", fields: [ownerId], references: [id])
  users          User[]               @relation("ShopUsers")
}

model Vehicle {
  id             String        @id @default(uuid())
  plate          String        @unique
  brand          String?
  model          String?
  year           Int?
  currentOwnerId String?
  createdBy      String?
  createdAt      DateTime      @default(now())

  cases          VehicleCase[]
}

model VehicleCase {
  id         String        @id @default(uuid())
  vehicleId  String
  ownerId    String?
  caseNumber String?
  damageDate DateTime?
  expertName String?
  phone      String?
  tcVkn      String?
  notes      String?
  status     CaseStatus    @default(opened)
  closedAt   DateTime?
  createdAt  DateTime      @default(now())

  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])
  photos     CasePhoto[]
  parts      CasePart[]
  operations CaseOperation[]
  activities Activity[]
}

model Activity {
  id        String       @id @default(uuid())
  scope     String
  refId     String
  type      String
  payload   Json
  actorId   String
  createdAt DateTime     @default(now())
  caseId    String?
  actor     User         @relation(fields: [actorId], references: [id])
  case      VehicleCase? @relation(fields: [caseId], references: [id])
}

model Customer {
  id              String                @id @default(uuid())
  name            String
  tcVkn           String?
  phone           String?
  email           String?
  createdAt       DateTime              @default(now())
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CustomVehicleEntry {
  id        String   @id @default(uuid())
  shopId    String
  brand     String
  model     String?
  year      Int?
  createdAt DateTime @default(now())
  package   String?
  shop      Shop     @relation(fields: [shopId], references: [id])
}

model VehicleBrand {
  id       String         @id @default(uuid())
  name     String         @unique
  isCustom Boolean        @default(false)
  shopId   String?
  models   VehicleModel[]
}

model VehicleModel {
  id       String        @id @default(uuid())
  name     String
  brandId  String
  isCustom Boolean       @default(false)
  shopId   String?
  brand    VehicleBrand  @relation(fields: [brandId], references: [id])
  years    VehicleYear[]

  @@unique([name, brandId])
}

model VehicleYear {
  id       String       @id @default(uuid())
  year     Int
  modelId  String
  isCustom Boolean      @default(false)
  shopId   String?
  model    VehicleModel @relation(fields: [modelId], references: [id])

  @@unique([year, modelId])
}

model CasePhoto {
  id          String      @id @default(uuid())
  caseId      String
  url         String
  storagePath String?
  addedBy     String?
  takenAt     DateTime?
  createdAt   DateTime    @default(now())

  case        VehicleCase @relation(fields: [caseId], references: [id])
}

model CasePart {
  id     String      @id @default(uuid())
  caseId String
  name   String
  status String      @default("pending")
  price  Float?
  createdAt DateTime @default(now())

  case   VehicleCase @relation(fields: [caseId], references: [id])
}

model CaseOperation {
  id        String      @id @default(uuid())
  caseId    String
  title     String
  status    String    @default("pending")
  notes     String?
  hours     Float?
  cost      Float?
  createdAt DateTime  @default(now())

  case      VehicleCase @relation(fields: [caseId], references: [id])
}

enum CaseStatus {
  opened
  inspection
  parts_waiting
  repairing
  paint
  ready
  delivered
}
