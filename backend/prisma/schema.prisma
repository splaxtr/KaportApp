generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  name               String
  role               String     @default("null")
  shopId             String?
  hashedRefreshToken String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLogin          DateTime?
  activities         Activity[]
  photos             Photo[]
  ownedShops         Shop[]     @relation("ShopOwner")
  shop               Shop?      @relation("ShopUsers", fields: [shopId], references: [id])
  vehicles           Vehicle[]  @relation("VehicleCreator")
}

model Shop {
  id             String               @id @default(uuid())
  name           String
  ownerId        String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  customVehicles CustomVehicleEntry[]
  parts          Part[]
  photos         Photo[]
  owner          User                 @relation("ShopOwner", fields: [ownerId], references: [id])
  users          User[]               @relation("ShopUsers")
  vehicles       Vehicle[]
}

model Vehicle {
  id             String                @id @default(uuid())
  shopId         String
  plate          String                @unique
  brand          String
  model          String
  year           Int?
  createdBy      String
  createdAt      DateTime              @default(now())
  deletedAt      DateTime?
  notes          String?
  package        String?
  currentOwnerId String?
  creator        User                  @relation("VehicleCreator", fields: [createdBy], references: [id])
  currentOwner   Customer?             @relation("VehicleCurrentOwner", fields: [currentOwnerId], references: [id])
  shop           Shop                  @relation(fields: [shopId], references: [id])
  cases          VehicleCase[]
  ownerHistory   VehicleOwnerHistory[]
}

model VehicleOwnerHistory {
  id         String    @id @default(uuid())
  vehicleId  String
  ownerId    String
  assignedAt DateTime  @default(now())
  releasedAt DateTime?
  owner      Customer  @relation(fields: [ownerId], references: [id])
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
}

model VehicleCase {
  id         String     @id @default(uuid())
  vehicleId  String
  ownerId    String?
  caseNumber String?
  damageDate DateTime?
  expertName String?
  phone      String?
  tcVkn      String?
  notes      String?
  createdAt  DateTime   @default(now())
  activities Activity[]
  parts      Part[]
  photos     Photo[]
  tasks      VehicleTask[]
  owner      Customer?  @relation("VehicleCaseOwner", fields: [ownerId], references: [id])
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])
}

model Part {
  id        String              @id @default(uuid())
  shopId    String
  name      String
  position  String?
  quantity  Int                 @default(1)
  statusKey String
  createdAt DateTime            @default(now())
  deletedAt DateTime?
  caseId    String?
  case      VehicleCase?        @relation(fields: [caseId], references: [id])
  shop      Shop                @relation(fields: [shopId], references: [id])
  status    PartStatus          @relation(fields: [statusKey], references: [key])
  histories PartStatusHistory[]
}

model PartStatus {
  key       String    @id
  label     String
  color     String
  order     Int       @unique
  deletedAt DateTime?
  parts     Part[]
}

model PartStatusHistory {
  id         String   @id @default(uuid())
  partId     String
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())
  changedBy  String?
  part       Part     @relation(fields: [partId], references: [id])

  @@index([partId])
}

model Photo {
  id          String       @id @default(uuid())
  shopId      String
  url         String
  storagePath String
  takenAt     DateTime     @default(now())
  addedBy     String
  deletedAt   DateTime?
  caseId      String?
  user        User         @relation(fields: [addedBy], references: [id])
  case        VehicleCase? @relation(fields: [caseId], references: [id])
  shop        Shop         @relation(fields: [shopId], references: [id])
}

model Activity {
  id        String       @id @default(uuid())
  scope     String
  refId     String
  type      String
  payload   Json
  actorId   String
  createdAt DateTime     @default(now())
  caseId    String?
  actor     User         @relation(fields: [actorId], references: [id])
  case      VehicleCase? @relation(fields: [caseId], references: [id])
}

model Customer {
  id              String                @id @default(uuid())
  name            String
  tcVkn           String?
  phone           String?
  email           String?
  createdAt       DateTime              @default(now())
  currentVehicles Vehicle[]             @relation("VehicleCurrentOwner")
  cases           VehicleCase[]         @relation("VehicleCaseOwner")
  history         VehicleOwnerHistory[]
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CustomVehicleEntry {
  id        String   @id @default(uuid())
  shopId    String
  brand     String
  model     String?
  year      Int?
  createdAt DateTime @default(now())
  package   String?
  shop      Shop     @relation(fields: [shopId], references: [id])
}

model VehicleTask {
  id        String       @id @default(uuid())
  caseId    String
  title     String
  status    String       @default("pending")
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  case      VehicleCase  @relation(fields: [caseId], references: [id])
}

model VehicleBrand {
  id       String         @id @default(uuid())
  name     String         @unique
  isCustom Boolean        @default(false)
  shopId   String?
  models   VehicleModel[]
}

model VehicleModel {
  id       String        @id @default(uuid())
  name     String
  brandId  String
  isCustom Boolean       @default(false)
  shopId   String?
  brand    VehicleBrand  @relation(fields: [brandId], references: [id])
  years    VehicleYear[]

  @@unique([name, brandId])
}

model VehicleYear {
  id       String       @id @default(uuid())
  year     Int
  modelId  String
  isCustom Boolean      @default(false)
  shopId   String?
  model    VehicleModel @relation(fields: [modelId], references: [id])

  @@unique([year, modelId])
}
