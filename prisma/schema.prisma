generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  system_admin
  admin
  employee
}

enum VehicleFileStatus {
  open
  pending
  completed
}

enum NotificationType {
  file_created
  status_changed
  part_updated
  appointment_reminder
  system
}

enum AppointmentType {
  intake
  delivery
  inspection
  expert
  other
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
}

model User {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  fullName     String
  email        String    @unique
  passwordHash String
  phone        String?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  permissions   UserPermission[]
  customerNotes CustomerNote[]
  photos        Photo[]
  appointments  Appointment[]
  notifications Notification[]
}

model Role {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  key         RoleKey   @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  key         String    @unique
  description String?

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Customer {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  fullName  String
  email     String?
  tcVkn     String?

  phones       CustomerPhone[]
  addresses    CustomerAddress[]
  notes        CustomerNote[]
  files        VehicleFile[]
  appointments Appointment[]

  @@index([fullName])
  @@index([deletedAt])
  @@index([tcVkn])
}

model CustomerPhone {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  label      String?
  phone      String
  customerId Int

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([customerId])
}

model CustomerAddress {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  label      String?
  address    String
  city       String?
  district   String?
  postalCode String?
  customerId Int

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  note       String
  customerId Int
  authorId   Int?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([authorId])
}

model Vehicle {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  plate           String
  plateNormalized String    @unique
  firstVisitAt    DateTime?
  lastVisitAt     DateTime?
  visitCount      Int       @default(0)

  files VehicleFile[]

  @@index([plate])
  @@index([deletedAt])
}

model VehicleFile {
  id           Int               @id @default(autoincrement())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  vehicleId    Int
  customerId   Int
  expertId     Int?
  status       VehicleFileStatus @default(open)
  brandModel   String
  color        String
  accidentDate DateTime?
  fileNumber   String?
  quickNote    String?
  discount     Decimal?  @db.Decimal(12, 2) @default(0)
  taxRate      Decimal?  @db.Decimal(5, 2) @default(20)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expert   Expert? @relation(fields: [expertId], references: [id], onDelete: SetNull)

  parts        Part[]
  operations   Operation[]
  photos       Photo[]
  reviewTokens ReviewToken[]
  appointments Appointment[]

  @@index([vehicleId])
  @@index([customerId])
  @@index([expertId])
  @@index([status])
  @@index([deletedAt])
}

model PartStatus {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  label      String
  color      String?
  sortOrder  Int       @default(0)
  parts      Part[]

  @@unique([label])
}

model Part {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  name          String
  description   String?
  quantity      Int       @default(1)
  unitPrice     Decimal?  @db.Decimal(12, 2)
  totalPrice    Decimal?  @db.Decimal(12, 2)
  vehicleFileId Int
  statusId      Int

  vehicleFile VehicleFile @relation(fields: [vehicleFileId], references: [id], onDelete: Cascade)
  status      PartStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@index([vehicleFileId])
  @@index([statusId])
  @@index([deletedAt])
}

model OperationStatus {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  label      String
  color      String?
  sortOrder  Int       @default(0)
  operations Operation[]

  @@unique([label])
}

model Operation {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  title         String
  description   String?
  laborCost     Decimal?  @db.Decimal(12, 2)
  materialCost  Decimal?  @db.Decimal(12, 2)
  vehicleFileId Int
  statusId      Int

  vehicleFile VehicleFile    @relation(fields: [vehicleFileId], references: [id], onDelete: Cascade)
  status      OperationStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@index([vehicleFileId])
  @@index([statusId])
  @@index([deletedAt])
}

model Photo {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  url           String
  title         String?
  note          String?
  vehicleFileId Int
  uploadedById  Int?

  vehicleFile VehicleFile @relation(fields: [vehicleFileId], references: [id], onDelete: Cascade)
  uploadedBy  User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([vehicleFileId])
  @@index([uploadedById])
  @@index([deletedAt])
}

model Expert {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  fullName  String
  phone     String?
  email     String?
  company   String?
  note      String?

  files VehicleFile[]

  @@index([deletedAt])
}

model ReviewToken {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  token         String    @unique
  vehicleFileId Int
  expiresAt     DateTime?
  revokedAt     DateTime?

  vehicleFile VehicleFile @relation(fields: [vehicleFileId], references: [id], onDelete: Cascade)
  accessKeys ReviewAccessKey[]

  @@index([vehicleFileId])
  @@index([revokedAt])
}

model ReviewAccessKey {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  key        String
  tokenId    Int

  token ReviewToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([usedAt])
}

model Appointment {
  id            Int               @id @default(autoincrement())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  date          DateTime
  endDate       DateTime?
  type          AppointmentType   @default(other)
  status        AppointmentStatus @default(scheduled)
  title         String
  notes         String?
  vehicleFileId Int?
  customerId    Int?
  assignedToId  Int?

  vehicleFile VehicleFile? @relation(fields: [vehicleFileId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo  User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([vehicleFileId])
  @@index([customerId])
  @@index([assignedToId])
  @@index([deletedAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  createdAt DateTime         @default(now())
  userId    Int
  type      NotificationType @default(system)
  title     String
  message   String
  link      String?
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model CompanySetting {
  id         Int      @id @default(autoincrement())
  updatedAt  DateTime @updatedAt
  name       String   @default("")
  address    String   @default("")
  phone      String   @default("")
  email      String   @default("")
  taxId      String   @default("")
  taxOffice  String   @default("")
}
